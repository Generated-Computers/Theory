import GC.GroupTheory.A5Programs.Basic

/-!
# Data for the nineteen orbits (manuscript 004c)

Orbit representatives of the generating pairs of `A₅` under conjugation by `S₅`, words in each
representative pair expressing `p` and `q`, the 21 maximal subgroups of `A₅` with abelian normal
subgroups containing their commutators, and one certificate for each of the 3600 pairs of
elements of `A₅`. All data were produced by a script and are checked by the kernel in
`Nineteen.lean`.
-/

namespace GC.A5Programs

open Equiv

/-- Words in two letters. -/
inductive PWord where
  | one : PWord
  | x : PWord
  | y : PWord
  | mul : PWord → PWord → PWord
  | inv : PWord → PWord

/-- A certificate for a pair `(x, y)`: either a permutation `σ` (as a vector) conjugating it to
the representative of orbit `k`, or a maximal subgroup `m` containing both elements. -/
inductive Cert where
  | hot : Fin 19 → (Fin 5 → Fin 5) → Cert
  | cold : Fin 21 → Cert

